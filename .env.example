# ---------------------------------------------------------------------------
# ClaimPilot configuration. Copy to .env and fill in ONE way to reach Gemini.
# With nothing set, the app runs in OFFLINE DEMO MODE (scripted model).
# ---------------------------------------------------------------------------

# Option A (easiest): Gemini API key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Option B: Vertex AI with your gcloud login (run: gcloud auth application-default login)
# GOOGLE_GENAI_USE_ENTERPRISE=true
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=global

# Models
GEMINI_MODEL=gemini-3.8-flash
ADJUDICATOR_MODEL=gemini-3.8-flash
GEMMA_MODEL=gemma-4-26b-a4b-it
# "low" keeps the pipeline fast. Leave empty for models without thinking levels (gemini-2.5-*).
THINKING_LEVEL=low

# Storage: local JSON + files on disk by default. Cloud Run uses Firestore + Cloud Storage.
STORE_BACKEND=local
# GCS_BUCKET=your-bucket
# DATA_DIR=./data

# Set to true to force the scripted offline model even when a key is present.
FORCE_OFFLINE=false
